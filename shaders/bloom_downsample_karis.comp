// =============================================================================
// BLOOM DOWNSAMPLE KARIS - First pass with Karis average for firefly reduction
// =============================================================================
// This shader is used ONLY for the first downsample pass.
// It applies the Karis average technique to prevent bright spots (fireflies)
// from dominating the bloom effect. Based on Brian Karis's presentation at
// SIGGRAPH 2014 for Unreal Engine 4.
// =============================================================================

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D srcTexture;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D dstImage;

layout(push_constant) uniform PushConstants {
    float threshold;
    float softThreshold;
    float filterRadius;
    int srcMipLevel;
} pc;

// Soft threshold curve for smooth bloom transition
vec3 applyThreshold(vec3 color) {
    float brightness = max(color.r, max(color.g, color.b));
    float soft = brightness - pc.threshold + pc.softThreshold;
    soft = clamp(soft, 0.0, 2.0 * pc.softThreshold);
    soft = soft * soft / (4.0 * pc.softThreshold + 0.00001);
    float contribution = max(soft, brightness - pc.threshold);
    contribution = contribution / max(brightness, 0.00001);
    return color * contribution;
}

// Karis average: weighted average based on luminance
// Prevents single bright pixels from dominating
float karisWeight(vec3 color) {
    float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));
    return 1.0 / (1.0 + luma);
}

// 13-tap filter with Karis weighting
vec3 downsample13TapKaris(vec2 uv, vec2 texelSize) {
    // Sample all 13 taps
    vec3 a = applyThreshold(texture(srcTexture, uv + texelSize * vec2(-1.0, -1.0)).rgb);
    vec3 b = applyThreshold(texture(srcTexture, uv + texelSize * vec2( 0.0, -1.0)).rgb);
    vec3 c = applyThreshold(texture(srcTexture, uv + texelSize * vec2( 1.0, -1.0)).rgb);
    vec3 d = applyThreshold(texture(srcTexture, uv + texelSize * vec2(-0.5, -0.5)).rgb);
    vec3 e = applyThreshold(texture(srcTexture, uv + texelSize * vec2( 0.5, -0.5)).rgb);
    vec3 f = applyThreshold(texture(srcTexture, uv + texelSize * vec2(-1.0,  0.0)).rgb);
    vec3 g = applyThreshold(texture(srcTexture, uv).rgb);  // Center
    vec3 h = applyThreshold(texture(srcTexture, uv + texelSize * vec2( 1.0,  0.0)).rgb);
    vec3 i = applyThreshold(texture(srcTexture, uv + texelSize * vec2(-0.5,  0.5)).rgb);
    vec3 j = applyThreshold(texture(srcTexture, uv + texelSize * vec2( 0.5,  0.5)).rgb);
    vec3 k = applyThreshold(texture(srcTexture, uv + texelSize * vec2(-1.0,  1.0)).rgb);
    vec3 l = applyThreshold(texture(srcTexture, uv + texelSize * vec2( 0.0,  1.0)).rgb);
    vec3 m = applyThreshold(texture(srcTexture, uv + texelSize * vec2( 1.0,  1.0)).rgb);

    // Group samples into quads for Karis averaging
    // Quad 1: d, e, i, j (center quad)
    float w1 = karisWeight((d + e + i + j) * 0.25);
    vec3 q1 = (d + e + i + j) * 0.25 * w1;

    // Quad 2: a, b, d, g (top-left)
    float w2 = karisWeight((a + b + d + g) * 0.25);
    vec3 q2 = (a + b + d + g) * 0.25 * w2;

    // Quad 3: b, c, e, h (top-right)
    float w3 = karisWeight((b + c + e + h) * 0.25);
    vec3 q3 = (b + c + e + h) * 0.25 * w3;

    // Quad 4: f, g, i, k (bottom-left)
    float w4 = karisWeight((f + g + i + k) * 0.25);
    vec3 q4 = (f + g + i + k) * 0.25 * w4;

    // Quad 5: g, h, j, l (bottom-right corner partial)
    float w5 = karisWeight((g + h + j + m) * 0.25);
    vec3 q5 = (g + h + j + m) * 0.25 * w5;

    // Combine with normalized weights
    float totalWeight = w1 * 0.5 + w2 * 0.125 + w3 * 0.125 + w4 * 0.125 + w5 * 0.125;
    vec3 result = (q1 * 0.5 + q2 * 0.125 + q3 * 0.125 + q4 * 0.125 + q5 * 0.125) / totalWeight;

    return result;
}

void main() {
    ivec2 dstCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = imageSize(dstImage);

    if (dstCoord.x >= dstSize.x || dstCoord.y >= dstSize.y) return;

    vec2 uv = (vec2(dstCoord) + 0.5) / vec2(dstSize);
    vec2 texelSize = 1.0 / vec2(textureSize(srcTexture, 0));

    vec3 color = downsample13TapKaris(uv, texelSize * pc.filterRadius);

    imageStore(dstImage, dstCoord, vec4(color, 1.0));
}
