// =============================================================================
// TONE MAPPING - HDR to LDR conversion with full color grading pipeline
// =============================================================================
// Implements multiple industry-standard tone mapping operators and a complete
// color grading pipeline similar to professional color correction tools.
// =============================================================================

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D srcTexture;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D dstImage;

layout(push_constant) uniform PushConstants {
    // Basic settings
    int tonemapOperator;
    float exposure;
    float gamma;
    float contrast;

    // Color grading
    float saturation;
    float brightness;
    float temperature;
    float tint;

    // Split toning
    vec4 shadowTint;     // rgb + strength
    vec4 highlightTint;  // rgb + strength

    // Vignette
    int vignetteEnabled;
    float vignetteIntensity;
    float vignetteSmoothness;
    float vignetteRoundness;

    // Film effects
    int chromaticAberrationEnabled;
    float chromaticAberrationIntensity;
    int filmGrainEnabled;
    float filmGrainIntensity;

    // Other
    float filmGrainResponse;
    int ditheringEnabled;
    float time;
    float _pad;
} pc;

// =============================================================================
// TONE MAPPING OPERATORS
// =============================================================================

// ACES Filmic tone mapping (approximation by Krzysztof Narkowicz)
vec3 tonemapACES(vec3 x) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

// Full ACES with RRT and ODT (more accurate)
vec3 tonemapACES_Full(vec3 color) {
    // sRGB -> ACEScg
    mat3 sRGB_to_ACEScg = mat3(
        0.613097, 0.339523, 0.047379,
        0.070194, 0.916354, 0.013452,
        0.020616, 0.109570, 0.869814
    );

    // ACEScg -> sRGB
    mat3 ACEScg_to_sRGB = mat3(
        1.704859, -0.621715, -0.083299,
        -0.130078,  1.140734, -0.010560,
        -0.023964, -0.128975,  1.153013
    );

    color = sRGB_to_ACEScg * color;

    // RRT (Reference Rendering Transform)
    const float a = 0.0245786;
    const float b = 0.000090537;
    const float c = 0.983729;
    const float d = 0.4329510;
    const float e = 0.238081;

    color = (color * (color + a) - b) / (color * (c * color + d) + e);

    color = ACEScg_to_sRGB * color;
    return clamp(color, 0.0, 1.0);
}

// Reinhard tone mapping
vec3 tonemapReinhard(vec3 color) {
    return color / (color + vec3(1.0));
}

// Extended Reinhard with white point
vec3 tonemapReinhardExtended(vec3 color, float whitePoint) {
    vec3 numerator = color * (1.0 + color / (whitePoint * whitePoint));
    return numerator / (1.0 + color);
}

// Uncharted 2 tone mapping
vec3 uncharted2Tonemap(vec3 x) {
    const float A = 0.15;  // Shoulder Strength
    const float B = 0.50;  // Linear Strength
    const float C = 0.10;  // Linear Angle
    const float D = 0.20;  // Toe Strength
    const float E = 0.02;  // Toe Numerator
    const float F = 0.30;  // Toe Denominator
    return ((x * (A * x + C * B) + D * E) / (x * (A * x + B) + D * F)) - E / F;
}

vec3 tonemapUncharted2(vec3 color) {
    const float W = 11.2;  // White point
    float exposureBias = 2.0;
    vec3 curr = uncharted2Tonemap(exposureBias * color);
    vec3 whiteScale = 1.0 / uncharted2Tonemap(vec3(W));
    return curr * whiteScale;
}

// Neutral tone mapping (minimal curve, just exposure and gamma)
vec3 tonemapNeutral(vec3 color) {
    return clamp(color, 0.0, 1.0);
}

// AgX tone mapping (Blender style)
vec3 agxDefaultContrastApprox(vec3 x) {
    vec3 x2 = x * x;
    vec3 x4 = x2 * x2;
    return + 15.5 * x4 * x2
           - 40.14 * x4 * x
           + 31.96 * x4
           - 6.868 * x2 * x
           + 0.4298 * x2
           + 0.1191 * x
           - 0.00232;
}

vec3 tonemapAgX(vec3 color) {
    const mat3 agxTransform = mat3(
        0.842479062253094, 0.0423282422610123, 0.0423756549057051,
        0.0784335999999992, 0.878468636469772, 0.0784336,
        0.0792237451477643, 0.0791661274605434, 0.879142973793104
    );

    const mat3 agxTransformInverse = mat3(
        1.19687900512017, -0.0528968517574562, -0.0529716355144438,
        -0.0980208811401368, 1.15190312990417, -0.0980434501171241,
        -0.0990297440797205, -0.0989611768448433, 1.15107367264116
    );

    color = agxTransform * color;
    color = max(color, 1e-10);
    color = log2(color);
    color = (color - vec3(-10.0)) / (vec3(6.5) - vec3(-10.0));
    color = clamp(color, 0.0, 1.0);
    color = agxDefaultContrastApprox(color);
    color = agxTransformInverse * color;

    return clamp(color, 0.0, 1.0);
}

// =============================================================================
// COLOR GRADING FUNCTIONS
// =============================================================================

// Convert RGB to HSL
vec3 rgb2hsl(vec3 c) {
    float maxC = max(c.r, max(c.g, c.b));
    float minC = min(c.r, min(c.g, c.b));
    float l = (maxC + minC) * 0.5;

    if (maxC == minC) {
        return vec3(0.0, 0.0, l);
    }

    float d = maxC - minC;
    float s = l > 0.5 ? d / (2.0 - maxC - minC) : d / (maxC + minC);

    float h;
    if (maxC == c.r) {
        h = (c.g - c.b) / d + (c.g < c.b ? 6.0 : 0.0);
    } else if (maxC == c.g) {
        h = (c.b - c.r) / d + 2.0;
    } else {
        h = (c.r - c.g) / d + 4.0;
    }
    h /= 6.0;

    return vec3(h, s, l);
}

// Convert HSL to RGB
float hue2rgb(float p, float q, float t) {
    if (t < 0.0) t += 1.0;
    if (t > 1.0) t -= 1.0;
    if (t < 1.0/6.0) return p + (q - p) * 6.0 * t;
    if (t < 1.0/2.0) return q;
    if (t < 2.0/3.0) return p + (q - p) * (2.0/3.0 - t) * 6.0;
    return p;
}

vec3 hsl2rgb(vec3 c) {
    if (c.y == 0.0) {
        return vec3(c.z);
    }

    float q = c.z < 0.5 ? c.z * (1.0 + c.y) : c.z + c.y - c.z * c.y;
    float p = 2.0 * c.z - q;

    return vec3(
        hue2rgb(p, q, c.x + 1.0/3.0),
        hue2rgb(p, q, c.x),
        hue2rgb(p, q, c.x - 1.0/3.0)
    );
}

// Apply saturation
vec3 applySaturation(vec3 color, float saturation) {
    float luminance = dot(color, vec3(0.2126, 0.7152, 0.0722));
    return mix(vec3(luminance), color, saturation);
}

// Apply contrast (pivot at 0.5)
vec3 applyContrast(vec3 color, float contrast) {
    return (color - 0.5) * contrast + 0.5;
}

// Apply white balance (temperature and tint)
vec3 applyWhiteBalance(vec3 color, float temperature, float tint) {
    // Temperature: negative = cool (blue), positive = warm (orange)
    // Tint: negative = green, positive = magenta

    // Simple approximation
    color.r += temperature * 0.1;
    color.b -= temperature * 0.1;

    color.g += tint * 0.05;
    color.r -= tint * 0.025;
    color.b -= tint * 0.025;

    return color;
}

// Apply split toning
vec3 applySplitToning(vec3 color, vec4 shadowTint, vec4 highlightTint) {
    float luminance = dot(color, vec3(0.2126, 0.7152, 0.0722));

    // Shadows (luminance < 0.5)
    float shadowWeight = 1.0 - smoothstep(0.0, 0.5, luminance);
    color = mix(color, color * shadowTint.rgb, shadowWeight * shadowTint.a);

    // Highlights (luminance > 0.5)
    float highlightWeight = smoothstep(0.5, 1.0, luminance);
    color = mix(color, color * highlightTint.rgb + highlightTint.rgb * 0.1, highlightWeight * highlightTint.a);

    return color;
}

// =============================================================================
// FILM EFFECTS
// =============================================================================

// Vignette effect
float calculateVignette(vec2 uv) {
    vec2 center = uv - 0.5;
    center.x *= pc.vignetteRoundness;
    float dist = length(center);
    return smoothstep(0.5, 0.5 - pc.vignetteSmoothness * 0.5, dist);
}

// Film grain
float filmGrainNoise(vec2 uv) {
    return fract(sin(dot(uv + vec2(pc.time), vec2(12.9898, 78.233))) * 43758.5453);
}

// Chromatic aberration
vec3 chromaticAberration(vec2 uv, vec2 texelSize) {
    float amount = pc.chromaticAberrationIntensity * 0.01;
    vec2 direction = normalize(uv - 0.5) * amount;

    vec3 result;
    result.r = texture(srcTexture, uv + direction).r;
    result.g = texture(srcTexture, uv).g;
    result.b = texture(srcTexture, uv - direction).b;

    return result;
}

// Dithering to reduce color banding
vec3 applyDithering(vec3 color, vec2 uv) {
    float noise = filmGrainNoise(uv * 1000.0 + pc.time);
    return color + (noise - 0.5) * (1.0 / 255.0);
}

// =============================================================================
// MAIN
// =============================================================================

void main() {
    ivec2 dstCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = imageSize(dstImage);

    if (dstCoord.x >= dstSize.x || dstCoord.y >= dstSize.y) return;

    vec2 uv = (vec2(dstCoord) + 0.5) / vec2(dstSize);
    vec2 texelSize = 1.0 / vec2(dstSize);

    // Sample input (with optional chromatic aberration)
    vec3 color;
    if (pc.chromaticAberrationEnabled != 0) {
        color = chromaticAberration(uv, texelSize);
    } else {
        color = texture(srcTexture, uv).rgb;
    }

    // Apply exposure
    color *= pow(2.0, pc.exposure);

    // Apply brightness (additive)
    color += vec3(pc.brightness);

    // Apply tone mapping
    switch (pc.tonemapOperator) {
        case 0: color = tonemapACES(color); break;
        case 1: color = tonemapReinhard(color); break;
        case 2: color = tonemapUncharted2(color); break;
        case 3: color = tonemapNeutral(color); break;
        case 4: color = tonemapAgX(color); break;
        default: color = tonemapACES(color); break;
    }

    // Apply color grading (post-tonemap for better control)
    color = applyWhiteBalance(color, pc.temperature, pc.tint);
    color = applyContrast(color, pc.contrast);
    color = applySaturation(color, pc.saturation);

    // Apply split toning
    if (pc.shadowTint.a > 0.0 || pc.highlightTint.a > 0.0) {
        color = applySplitToning(color, pc.shadowTint, pc.highlightTint);
    }

    // Apply vignette
    if (pc.vignetteEnabled != 0) {
        float vignette = calculateVignette(uv);
        color *= mix(1.0 - pc.vignetteIntensity, 1.0, vignette);
    }

    // Apply film grain
    if (pc.filmGrainEnabled != 0) {
        float grain = filmGrainNoise(uv);
        float luminance = dot(color, vec3(0.2126, 0.7152, 0.0722));
        float grainResponse = mix(1.0, 1.0 - luminance, pc.filmGrainResponse);
        color += (grain - 0.5) * pc.filmGrainIntensity * grainResponse;
    }

    // Apply gamma correction
    color = pow(max(color, 0.0), vec3(1.0 / pc.gamma));

    // Apply dithering (reduces banding in gradients)
    if (pc.ditheringEnabled != 0) {
        color = applyDithering(color, uv);
    }

    // Clamp final output
    color = clamp(color, 0.0, 1.0);

    imageStore(dstImage, dstCoord, vec4(color, 1.0));
}
