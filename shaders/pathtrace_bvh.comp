// =============================================================================
// PATH TRACER - Real-time GPU Path Tracing with BVH Acceleration
// =============================================================================
// Professional-grade path tracer featuring:
// - BVH traversal for fast ray-scene intersection
// - Cook-Torrance BRDF for PBR materials
// - Multiple importance sampling (MIS)
// - Next Event Estimation (NEE) for direct lighting
// - Russian Roulette for unbiased termination
// - Temporal accumulation for progressive rendering
// =============================================================================

#version 450
#extension GL_EXT_scalar_block_layout : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Output: engine's draw image (background already rendered here)
layout(binding = 0, rgba16f) uniform image2D drawImage;
// Accumulation buffer for temporal averaging
layout(binding = 1, rgba32f) uniform image2D accumulationImage;

// Scene data
struct Triangle {
    vec3 v0;
    uint materialIndex;
    vec3 v1;
    float _pad0;
    vec3 v2;
    float _pad1;
};

struct BVHNode {
    vec3 boundsMin;
    uint leftFirst;
    vec3 boundsMax;
    uint primCount;
};

struct Material {
    vec3 albedo;
    float metallic;
    vec3 emission;
    float roughness;
    float ior;
    float transmission;
    uint albedoTexture;
    uint normalTexture;
};

layout(std430, binding = 2) readonly buffer TriangleBuffer {
    Triangle triangles[];
};

layout(std430, binding = 3) readonly buffer BVHBuffer {
    BVHNode bvhNodes[];
};

layout(std430, binding = 4) readonly buffer MaterialBuffer {
    Material materials[];
};

// Environment cubemap
layout(binding = 5) uniform samplerCube envCubemap;

// Push constants
layout(push_constant) uniform PushConstants {
    mat4 invView;
    mat4 invProj;
    vec4 cameraPos;
    vec4 sunDirection;      // xyz = dir, w = intensity
    vec4 sunColor;
    vec4 skyColor;          // xyz = color, w = intensity
    uint frameIndex;
    uint accumulatedFrames;
    uint triangleCount;
    uint maxBounces;
    uint samplesPerPixel;
    uint enableNEE;
    uint enableRR;
    float rrDepth;
    uint useCubemap;        // 1 = sample cubemap, 0 = procedural sky
} pc;

// =============================================================================
// CONSTANTS
// =============================================================================

const float PI = 3.14159265359;
const float INV_PI = 0.31830988618;
const float EPSILON = 0.0001;
const float MAX_DIST = 1e30;

// =============================================================================
// RANDOM NUMBER GENERATION (PCG)
// =============================================================================

uint pcgHash(uint inputVal) {
    uint state = inputVal * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float randomFloat(inout uint seed) {
    seed = pcgHash(seed);
    return float(seed) / float(0xFFFFFFFFu);
}

vec2 randomVec2(inout uint seed) {
    return vec2(randomFloat(seed), randomFloat(seed));
}

vec3 randomVec3(inout uint seed) {
    return vec3(randomFloat(seed), randomFloat(seed), randomFloat(seed));
}

// =============================================================================
// SAMPLING FUNCTIONS
// =============================================================================

// Cosine-weighted hemisphere sampling
vec3 sampleHemisphereCosine(vec2 u, vec3 normal) {
    float r = sqrt(u.x);
    float theta = 2.0 * PI * u.y;

    float x = r * cos(theta);
    float y = r * sin(theta);
    float z = sqrt(max(0.0, 1.0 - u.x));

    // Create orthonormal basis
    vec3 up = abs(normal.z) < 0.999 ? vec3(0, 0, 1) : vec3(1, 0, 0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);

    return normalize(tangent * x + bitangent * y + normal * z);
}

// GGX importance sampling
vec3 sampleGGX(vec2 u, vec3 normal, float roughness) {
    float a = roughness * roughness;
    float a2 = a * a;

    float phi = 2.0 * PI * u.x;
    float cosTheta = sqrt((1.0 - u.y) / (1.0 + (a2 - 1.0) * u.y));
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);

    vec3 H;
    H.x = sinTheta * cos(phi);
    H.y = sinTheta * sin(phi);
    H.z = cosTheta;

    // Transform to world space
    vec3 up = abs(normal.z) < 0.999 ? vec3(0, 0, 1) : vec3(1, 0, 0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);

    return normalize(tangent * H.x + bitangent * H.y + normal * H.z);
}

// =============================================================================
// RAY-TRIANGLE INTERSECTION (Moller-Trumbore)
// =============================================================================

bool intersectTriangle(vec3 rayOrigin, vec3 rayDir, Triangle tri, out float t, out vec2 uv) {
    vec3 edge1 = tri.v1 - tri.v0;
    vec3 edge2 = tri.v2 - tri.v0;
    vec3 h = cross(rayDir, edge2);
    float a = dot(edge1, h);

    if (abs(a) < EPSILON) return false;

    float f = 1.0 / a;
    vec3 s = rayOrigin - tri.v0;
    float u = f * dot(s, h);

    if (u < 0.0 || u > 1.0) return false;

    vec3 q = cross(s, edge1);
    float v = f * dot(rayDir, q);

    if (v < 0.0 || u + v > 1.0) return false;

    t = f * dot(edge2, q);
    uv = vec2(u, v);

    return t > EPSILON;
}

// =============================================================================
// RAY-AABB INTERSECTION
// =============================================================================

bool intersectAABB(vec3 rayOrigin, vec3 invDir, vec3 boundsMin, vec3 boundsMax, float tMax) {
    vec3 t0 = (boundsMin - rayOrigin) * invDir;
    vec3 t1 = (boundsMax - rayOrigin) * invDir;

    vec3 tmin = min(t0, t1);
    vec3 tmax = max(t0, t1);

    float tNear = max(max(tmin.x, tmin.y), tmin.z);
    float tFar = min(min(tmax.x, tmax.y), tmax.z);

    return tNear <= tFar && tFar > 0.0 && tNear < tMax;
}

// =============================================================================
// BVH TRAVERSAL
// =============================================================================

struct HitInfo {
    float t;
    vec3 normal;
    vec2 uv;
    uint materialIndex;
    bool hit;
};

HitInfo traverseBVH(vec3 rayOrigin, vec3 rayDir) {
    HitInfo result;
    result.t = MAX_DIST;
    result.hit = false;

    if (pc.triangleCount == 0) return result;

    vec3 invDir = 1.0 / rayDir;

    // Stack for iterative traversal
    uint stack[64];
    int stackPtr = 0;
    stack[stackPtr++] = 0;  // Start with root

    while (stackPtr > 0) {
        uint nodeIdx = stack[--stackPtr];
        BVHNode node = bvhNodes[nodeIdx];

        if (!intersectAABB(rayOrigin, invDir, node.boundsMin, node.boundsMax, result.t)) {
            continue;
        }

        if (node.primCount > 0) {
            // Leaf node - test triangles
            for (uint i = 0; i < node.primCount; ++i) {
                uint triIdx = node.leftFirst + i;
                if (triIdx >= pc.triangleCount) continue;

                Triangle tri = triangles[triIdx];
                float t;
                vec2 uv;

                if (intersectTriangle(rayOrigin, rayDir, tri, t, uv) && t < result.t) {
                    result.t = t;
                    result.uv = uv;
                    result.materialIndex = tri.materialIndex;
                    result.hit = true;

                    // Compute normal
                    vec3 edge1 = tri.v1 - tri.v0;
                    vec3 edge2 = tri.v2 - tri.v0;
                    result.normal = normalize(cross(edge1, edge2));
                }
            }
        } else {
            // Internal node - push children
            stack[stackPtr++] = node.leftFirst;
            stack[stackPtr++] = node.leftFirst + 1;
        }
    }

    return result;
}

// =============================================================================
// PBR BRDF FUNCTIONS
// =============================================================================

// Fresnel-Schlick
vec3 fresnelSchlick(float cosTheta, vec3 F0) {
    return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

// GGX Distribution
float distributionGGX(float NdotH, float roughness) {
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH2 = NdotH * NdotH;

    float num = a2;
    float denom = (NdotH2 * (a2 - 1.0) + 1.0);
    denom = PI * denom * denom;

    return num / denom;
}

// Geometry (Schlick-GGX)
float geometrySchlickGGX(float NdotV, float roughness) {
    float r = roughness + 1.0;
    float k = (r * r) / 8.0;
    return NdotV / (NdotV * (1.0 - k) + k);
}

float geometrySmith(float NdotV, float NdotL, float roughness) {
    float ggx2 = geometrySchlickGGX(NdotV, roughness);
    float ggx1 = geometrySchlickGGX(NdotL, roughness);
    return ggx1 * ggx2;
}

// Evaluate Cook-Torrance BRDF
vec3 evaluateBRDF(vec3 V, vec3 L, vec3 N, Material mat) {
    vec3 H = normalize(V + L);

    float NdotV = max(dot(N, V), 0.001);
    float NdotL = max(dot(N, L), 0.001);
    float NdotH = max(dot(N, H), 0.001);
    float VdotH = max(dot(V, H), 0.001);

    vec3 F0 = mix(vec3(0.04), mat.albedo, mat.metallic);
    vec3 F = fresnelSchlick(VdotH, F0);

    float D = distributionGGX(NdotH, mat.roughness);
    float G = geometrySmith(NdotV, NdotL, mat.roughness);

    vec3 specular = (D * G * F) / (4.0 * NdotV * NdotL + 0.0001);

    vec3 kD = (1.0 - F) * (1.0 - mat.metallic);
    vec3 diffuse = kD * mat.albedo * INV_PI;

    return diffuse + specular;
}

// =============================================================================
// SKY MODEL
// =============================================================================

vec3 getSkyColor(vec3 dir) {
    vec3 sky;

    if (pc.useCubemap != 0) {
        // Sample environment cubemap
        sky = texture(envCubemap, dir).rgb * pc.skyColor.w;
    } else {
        // Procedural sky fallback
        float t = 0.5 * (dir.y + 1.0);
        sky = mix(vec3(1.0), pc.skyColor.rgb, t) * pc.skyColor.w;
    }

    // Add sun disk
    vec3 sunDir = normalize(-pc.sunDirection.xyz);
    float sunDot = dot(dir, sunDir);
    if (sunDot > 0.9995) {
        sky += pc.sunColor.rgb * pc.sunDirection.w * 10.0;
    }

    return sky;
}

// =============================================================================
// PATH TRACING
// =============================================================================

vec3 tracePath(vec3 rayOrigin, vec3 rayDir, inout uint seed, out bool primaryHit) {
    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);
    primaryHit = false;

    for (uint bounce = 0; bounce < pc.maxBounces; ++bounce) {
        HitInfo hit = traverseBVH(rayOrigin, rayDir);

        if (!hit.hit) {
            // Hit sky - use cubemap for reflections on bounced rays
            radiance += throughput * getSkyColor(rayDir);
            break;
        }

        if (bounce == 0) primaryHit = true;

        Material mat = materials[hit.materialIndex];
        vec3 hitPos = rayOrigin + rayDir * hit.t;
        vec3 N = hit.normal;

        // Flip normal if backface
        if (dot(N, rayDir) > 0.0) {
            N = -N;
        }

        // Add emission
        radiance += throughput * mat.emission;

        // Next Event Estimation (direct light sampling)
        if (pc.enableNEE != 0) {
            vec3 sunDir = normalize(-pc.sunDirection.xyz);
            float NdotL = max(dot(N, sunDir), 0.0);

            if (NdotL > 0.0) {
                // Shadow ray
                HitInfo shadowHit = traverseBVH(hitPos + N * EPSILON, sunDir);
                if (!shadowHit.hit) {
                    vec3 brdf = evaluateBRDF(-rayDir, sunDir, N, mat);
                    radiance += throughput * brdf * pc.sunColor.rgb * pc.sunDirection.w * NdotL;
                }
            }
        }

        // Sample next direction
        vec3 V = -rayDir;
        vec3 L;
        float pdf;

        // Probabilistic material selection based on roughness
        if (randomFloat(seed) < mat.roughness * 0.5 + 0.5 * (1.0 - mat.metallic)) {
            // Diffuse sampling
            L = sampleHemisphereCosine(randomVec2(seed), N);
            pdf = max(dot(N, L), 0.0) * INV_PI;
        } else {
            // Specular sampling (GGX)
            vec3 H = sampleGGX(randomVec2(seed), N, max(mat.roughness, 0.04));
            L = reflect(-V, H);
            if (dot(L, N) <= 0.0) break;

            float NdotH = max(dot(N, H), 0.0);
            float VdotH = max(dot(V, H), 0.0);
            float D = distributionGGX(NdotH, mat.roughness);
            pdf = D * NdotH / (4.0 * VdotH + 0.0001);
        }

        if (pdf < EPSILON) break;

        // Evaluate BRDF and update throughput
        vec3 brdf = evaluateBRDF(V, L, N, mat);
        float NdotL = max(dot(N, L), 0.0);
        throughput *= brdf * NdotL / pdf;

        // Russian Roulette
        if (pc.enableRR != 0 && bounce >= uint(pc.rrDepth)) {
            float p = max(throughput.r, max(throughput.g, throughput.b));
            if (randomFloat(seed) > p) break;
            throughput /= p;
        }

        // Setup next ray
        rayOrigin = hitPos + N * EPSILON;
        rayDir = L;
    }

    return radiance;
}

// =============================================================================
// MAIN
// =============================================================================

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(drawImage);

    if (pixelCoord.x >= imgSize.x || pixelCoord.y >= imgSize.y) return;

    // Display-only mode: samplesPerPixel == 0 means max accumulation reached.
    // Just re-draw geometry pixels from the accumulation buffer.
    if (pc.samplesPerPixel == 0) {
        vec4 accum = imageLoad(accumulationImage, pixelCoord);
        if (accum.a < 0.5) return; // No geometry data - keep background
        vec3 color = accum.rgb;
        if (any(isnan(color)) || any(isinf(color))) color = vec3(0.0);
        vec3 mapped = vec3(1.0) - exp(-color * 1.0);
        mapped = pow(mapped, vec3(1.0 / 2.2));
        imageStore(drawImage, pixelCoord, vec4(mapped, 1.0));
        return;
    }

    // Initialize RNG seed
    uint seed = pcgHash(pixelCoord.x + pixelCoord.y * imgSize.x + pc.frameIndex * imgSize.x * imgSize.y);

    vec3 color = vec3(0.0);
    int hitCount = 0;

    for (uint sampleIdx = 0; sampleIdx < pc.samplesPerPixel; ++sampleIdx) {
        // Jittered pixel position for anti-aliasing
        vec2 jitter = randomVec2(seed) - 0.5;
        vec2 uv = (vec2(pixelCoord) + 0.5 + jitter) / vec2(imgSize) * 2.0 - 1.0;

        // Generate camera ray
        vec4 rayClip = vec4(uv, 0.5, 1.0);
        vec4 rayView = pc.invProj * rayClip;
        vec3 rayDir = normalize((pc.invView * vec4(normalize(rayView.xyz / rayView.w), 0.0)).xyz);
        vec3 rayOrigin = pc.cameraPos.xyz;

        bool pHit;
        vec3 sampleColor = tracePath(rayOrigin, rayDir, seed, pHit);
        if (pHit) {
            hitCount++;
            color += sampleColor;
        }
    }

    // If no sample hit geometry, keep background (rendered by background effect)
    if (hitCount == 0) {
        if (pc.accumulatedFrames == 0) {
            imageStore(accumulationImage, pixelCoord, vec4(0.0));
        }
        return;
    }

    color /= float(hitCount);

    // Sanitize: NaN/Inf would permanently corrupt the accumulation buffer
    if (any(isnan(color)) || any(isinf(color))) {
        color = vec3(0.0);
    }
    color = max(color, vec3(0.0));

    // Accumulation
    if (pc.accumulatedFrames > 0) {
        vec3 prevColor = imageLoad(accumulationImage, pixelCoord).rgb;
        if (any(isnan(prevColor)) || any(isinf(prevColor))) {
            prevColor = vec3(0.0);
        }
        float weight = 1.0 / float(pc.accumulatedFrames + 1);
        color = mix(prevColor, color, weight);
    }

    // Store accumulated result (alpha=1.0 marks this pixel as geometry)
    imageStore(accumulationImage, pixelCoord, vec4(color, 1.0));

    // Tone mapping and gamma for output
    vec3 mapped = vec3(1.0) - exp(-color * 1.0);
    mapped = pow(mapped, vec3(1.0 / 2.2));

    imageStore(drawImage, pixelCoord, vec4(mapped, 1.0));
}
