// =============================================================================
// BLOOM UPSAMPLE - Tent filter upsampling with additive blend
// =============================================================================
// Upsamples the bloom mip chain using a 9-tap tent filter for smooth results.
// Each level is additively blended with the next higher resolution level.
// =============================================================================

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D srcTexture;
layout(set = 0, binding = 1, rgba16f) uniform image2D dstImage;

layout(push_constant) uniform PushConstants {
    float threshold;
    float softThreshold;
    float filterRadius;
    int srcMipLevel;
} pc;

// 9-tap tent filter for smooth upsampling
// Weights form a bilinear tent shape
vec3 upsample9Tap(vec2 uv, vec2 texelSize) {
    vec3 a = texture(srcTexture, uv + texelSize * vec2(-1.0, -1.0)).rgb;
    vec3 b = texture(srcTexture, uv + texelSize * vec2( 0.0, -1.0)).rgb;
    vec3 c = texture(srcTexture, uv + texelSize * vec2( 1.0, -1.0)).rgb;
    vec3 d = texture(srcTexture, uv + texelSize * vec2(-1.0,  0.0)).rgb;
    vec3 e = texture(srcTexture, uv).rgb;  // Center
    vec3 f = texture(srcTexture, uv + texelSize * vec2( 1.0,  0.0)).rgb;
    vec3 g = texture(srcTexture, uv + texelSize * vec2(-1.0,  1.0)).rgb;
    vec3 h = texture(srcTexture, uv + texelSize * vec2( 0.0,  1.0)).rgb;
    vec3 i = texture(srcTexture, uv + texelSize * vec2( 1.0,  1.0)).rgb;

    // Tent filter weights:
    // 1 2 1
    // 2 4 2  / 16
    // 1 2 1
    vec3 result = e * 4.0;
    result += (b + d + f + h) * 2.0;
    result += (a + c + g + i);
    result *= (1.0 / 16.0);

    return result;
}

void main() {
    ivec2 dstCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = imageSize(dstImage);

    if (dstCoord.x >= dstSize.x || dstCoord.y >= dstSize.y) return;

    vec2 uv = (vec2(dstCoord) + 0.5) / vec2(dstSize);
    vec2 texelSize = 1.0 / vec2(textureSize(srcTexture, 0));

    vec3 upsampled = upsample9Tap(uv, texelSize * pc.filterRadius);

    // Read existing value and blend additively
    vec3 existing = imageLoad(dstImage, dstCoord).rgb;
    vec3 result = existing + upsampled;

    imageStore(dstImage, dstCoord, vec4(result, 1.0));
}
