#version 450

layout(local_size_x = 16, local_size_y = 16) in;

// Output: engine's draw image
layout(rgba16f, set = 0, binding = 0) uniform image2D image;

// Environment cubemap
layout(set = 0, binding = 1) uniform samplerCube envCubemap;

// Push constants: camera matrices for ray generation
layout(push_constant) uniform PushConstants {
    mat4 invView;
    mat4 invProj;
} pc;

void main() {
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(image);

    if (texelCoord.x >= size.x || texelCoord.y >= size.y) return;

    // Convert pixel coordinate to normalized device coordinates
    vec2 uv = (vec2(texelCoord) + 0.5) / vec2(size) * 2.0 - 1.0;

    // Generate world-space ray direction from camera
    vec4 rayClip = vec4(uv, 0.5, 1.0);
    vec4 rayView = pc.invProj * rayClip;
    vec3 rayDir = normalize((pc.invView * vec4(normalize(rayView.xyz / rayView.w), 0.0)).xyz);

    // Sample environment cubemap
    vec3 color = texture(envCubemap, rayDir).rgb;

    // Tone map (exposure) + gamma correction
    color = vec3(1.0) - exp(-color * 1.0);
    color = pow(color, vec3(1.0 / 2.2));

    imageStore(image, texelCoord, vec4(color, 1.0));
}
