// =============================================================================
// BLOOM DOWNSAMPLE - 13-tap filter for high quality downsampling
// =============================================================================
// Uses a 13-tap filter that approximates a Gaussian blur while being efficient.
// This is the standard downsample pass - see bloom_downsample_karis.comp for
// the first pass with Karis average to prevent fireflies.
// =============================================================================

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D srcTexture;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D dstImage;

layout(push_constant) uniform PushConstants {
    float threshold;
    float softThreshold;
    float filterRadius;
    int srcMipLevel;
} pc;

// 13-tap filter kernel from Call of Duty: Advanced Warfare
// Weights: center(0.125), inner(0.0625 each), outer(0.03125 each)
vec3 downsample13Tap(vec2 uv, vec2 texelSize) {
    vec3 a = texture(srcTexture, uv + texelSize * vec2(-1.0, -1.0)).rgb;
    vec3 b = texture(srcTexture, uv + texelSize * vec2( 0.0, -1.0)).rgb;
    vec3 c = texture(srcTexture, uv + texelSize * vec2( 1.0, -1.0)).rgb;
    vec3 d = texture(srcTexture, uv + texelSize * vec2(-0.5, -0.5)).rgb;
    vec3 e = texture(srcTexture, uv + texelSize * vec2( 0.5, -0.5)).rgb;
    vec3 f = texture(srcTexture, uv + texelSize * vec2(-1.0,  0.0)).rgb;
    vec3 g = texture(srcTexture, uv).rgb;  // Center
    vec3 h = texture(srcTexture, uv + texelSize * vec2( 1.0,  0.0)).rgb;
    vec3 i = texture(srcTexture, uv + texelSize * vec2(-0.5,  0.5)).rgb;
    vec3 j = texture(srcTexture, uv + texelSize * vec2( 0.5,  0.5)).rgb;
    vec3 k = texture(srcTexture, uv + texelSize * vec2(-1.0,  1.0)).rgb;
    vec3 l = texture(srcTexture, uv + texelSize * vec2( 0.0,  1.0)).rgb;
    vec3 m = texture(srcTexture, uv + texelSize * vec2( 1.0,  1.0)).rgb;

    // Apply weighted average
    // 4 inner samples (0.5 weight each, distributed across 4 samples = 0.125)
    vec3 inner = (d + e + i + j) * 0.125;

    // 4 outer corners (0.125 weight total)
    vec3 outerCorners = (a + c + k + m) * 0.03125;

    // 4 outer edges (0.25 weight total)
    vec3 outerEdges = (b + f + h + l) * 0.0625;

    // Center sample
    vec3 center = g * 0.125;

    return inner + outerCorners + outerEdges + center;
}

void main() {
    ivec2 dstCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = imageSize(dstImage);

    if (dstCoord.x >= dstSize.x || dstCoord.y >= dstSize.y) return;

    // Calculate UV with 0.5 texel offset for proper sampling
    vec2 uv = (vec2(dstCoord) + 0.5) / vec2(dstSize);
    vec2 texelSize = 1.0 / vec2(textureSize(srcTexture, 0));

    vec3 color = downsample13Tap(uv, texelSize * pc.filterRadius);

    imageStore(dstImage, dstCoord, vec4(color, 1.0));
}
